{
  "name": "markdowndown",
  "version": "0.1.0",
  "description": "Markdown++ — GFM extended with wikilinks, diagram DSL, and SVG tables",
  "type": "module",
  "bin": {
    "mdd": "./dist/cli.cjs",
    "markdowndown": "./dist/cli.cjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node build.mjs",
    "showcase": "node dist/cli.cjs showcase/showcase.mdd --single -o showcase/showcase.html",
    "postbuild": "npm link --force",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=\"tests/\""
  },
  "dependencies": {
    "commander": "^12.1.0",
    "esbuild": "^0.23.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.5.0",
    "esbuild": "^0.23.1",
    "eslint": "^10.8.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  }
}
